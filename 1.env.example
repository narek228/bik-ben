# Telegram
BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token

# LLM ключи (нужен хотя бы один, лучше оба)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ЮKassa (https://yookassa.ru/my/shop-settings/api-keys)
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_or_test_secret_key

# NOWPayments — крипто-эквайринг (https://nowpayments.io)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_for_webhook_verification

# Публичный URL сервера для приёма webhook от платёжных систем
# (нужен, если бот работает не локально — например, домен на VPS)
PUBLIC_WEBHOOK_URL=https://yourdomain.com

# Наценка: во сколько раз цена для юзера выше себестоимости токенов у провайдера
MARKUP_MULTIPLIER=3.0
