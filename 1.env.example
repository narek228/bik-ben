# Telegram
BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token

# LLM ключи (нужен хотя бы один, лучше оба)
# ВАЖНО: ключ должен быть от ТОГО ЖЕ провайдера, чей BASE_URL указан ниже.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Базовый URL текстовых моделей (оставьте пустым для официального OpenAI)
# Примеры:
#   ProxyAPI:  https://api.proxyapi.ru/openai/v1
#   LMRouter:  https://api.lmrouter.com/openai/v1
#   OpenAI:    https://api.openai.com/v1
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# ---------- Картинки ----------
# URL для /images/generations. Если пусто — используется OPENAI_BASE_URL.
# У некоторых провайдеров адрес картинок совпадает с текстовым.
IMAGE_BASE_URL=

# Слаг image-модели из каталога вашего провайдера.
# Примеры:
#   OpenAI:     dall-e-3
#   ProxyAPI:   dall-e-3  (или как в их каталоге)
#   LMRouter:   смотрите актуальный слаг в кабинете (например closerouter-...)
IMAGE_MODEL=dall-e-3

# Сколько кредитов списывать за одну картинку
IMAGE_COST_CREDITS=15

# ЮKassa (https://yookassa.ru/my/shop-settings/api-keys)
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_or_test_secret_key

# NOWPayments — крипто-эквайринг (https://nowpayments.io)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_for_webhook_verification

# ЮMoney (личный кошелёк)
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=

# Публичный URL сервера для webhook платёжных систем
PUBLIC_WEBHOOK_URL=https://yourdomain.com

# Наценка: во сколько раз цена для юзера выше себестоимости токенов
MARKUP_MULTIPLIER=3.0

# Курс USD → кредиты (1 кредит ≈ 1 рубль)
USD_TO_CREDIT_RATE=100
